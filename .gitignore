# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
venv/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Environment files
.env
.venv

# OS-specific files
.DS_Store
Thumbs.db

# Logs
*.log

# Python packaging
*.egg-info/
dist/
build/

# --- Ignore EVERYTHING inside the main data folders ---

# This ignores all files inside the electricity and housing folders,
# including the CSVs and the Parquet files we want to skip.
/data/electricity/**
/data/housing/**

# --- EXCEPTION: UN-IGNORE specific files and folders ---

# Keep the data/electricity/processed/ directory (if it exists)
!/data/electricity/processed/

# Keep the data/housing/processed/ directory (if it exists)
!/data/housing/processed/

# Keep the .gitkeep files (to maintain structure on clone)
!/data/electricity/processed/.gitkeep
!/data/housing/processed/.gitkeep

# Optionally add a .gitkeep file in empty folders so Git tracks them

!/data/trained_models/electricity/ND_model.pkl
data/trained_models/electricity/dtr_baseline_model.joblib
data/trained_models/electricity/ND_model.pkl


# ==========================
# PYTHON & BACKEND IGNORES
# ==========================

# 1. Cache de Python (se genera automáticamente y ensucia el repo)
__pycache__/
*.py[cod]

# 2. Variables de Entorno (SEGURIDAD CRÍTICA: Contiene claves privadas)
.env

# 3. Logs del sistema (Archivos de registro)
*.log
deployment/backend/logs.log
